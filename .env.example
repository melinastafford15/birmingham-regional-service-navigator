# CivicRoute BHM — environment template
#
# Copy to .env.local and fill in. .env* files are gitignored; never commit a real key.
#
#   cp .env.example .env.local

# Enables model-based problem classification.
# OPTIONAL: without it the app still runs and classification falls back to
# deterministic keyword rules. The demo does not depend on this key.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OPTIONAL: required only for identity-linked keys scoped to a specific Anthropic
# workspace. Leave blank for ordinary API keys.
ANTHROPIC_WORKSPACE_ID=
